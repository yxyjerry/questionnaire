/* questionnaire/preview/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  text-align: center;
  padding: 30rpx 0;
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
}

.content {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.question-list {
  margin-top: 20rpx;
}

.question-item {
  padding: 30rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  background-color: #fafafa;
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-index {
  font-weight: bold;
  font-size: 30rpx;
  color: #333;
  margin-right: 10rpx;
}

.question-content {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  word-break: break-all;
}

.required {
  color: #ff4757;
  font-weight: bold;
  margin-left: 5rpx;
}

.options {
  margin-left: 40rpx;
}

.option-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.option-item:last-child {
  margin-bottom: 0;
}

.option-text {
  font-size: 28rpx;
  color: #555;
  margin-left: 10rpx;
  flex: 1;
  word-break: break-all;
}

.fill-input {
  margin-left: 40rpx;
}

.fill-textarea {
  width: 100%;
  height: 160rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  text-align: left;
}

.empty-tips {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.1);
}

.btn-submit {
  width: 100%;
  height: 80rpx;
  background-color: #007aff;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  line-height: 80rpx;
}